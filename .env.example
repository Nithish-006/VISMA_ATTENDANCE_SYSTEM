# Copy this file to .env and fill in real values. .env is gitignored.

# --- Primary attendance/salary database ---
# Either provide a full DATABASE_URL...
DATABASE_URL=mysql://root:password@localhost:3306/visma_attendance
# ...or rely on Railway's MYSQL* vars in production.

FLASK_ENV=development
SECRET_KEY=change-me

# --- Shared VISMA projects registry (read-only) ---
# Source of truth for the project dropdown. The app only runs:
#   SELECT id, stem_name FROM projects ORDER BY id;
PROJECTS_DB_HOST=your-registry-host
PROJECTS_DB_PORT=3306
PROJECTS_DB_USER=root
PROJECTS_DB_PASSWORD=your-registry-password
PROJECTS_DB_NAME=visma_financial

# Seconds to cache the projects list before re-querying (default 60).
PROJECTS_CACHE_TTL=60
